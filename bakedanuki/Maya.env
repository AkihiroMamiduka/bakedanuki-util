# bakedanuki Maya.env sample
#
# Copy the MAYA_MODULE_PATH line below to your own Maya.env.
# Maya 2025 default location:
#   %USERPROFILE%\Documents\maya\2025\Maya.env
# For Maya 2026 / 2027, replace 2025 with the Maya version you use.
#
# Replace D:\path\to\bakedanuki with the actual bakedanuki folder path.
# The target folder should contain the modules folder:
#   D:\path\to\bakedanuki\modules
#
# If MAYA_MODULE_PATH already exists in your Maya.env, add this path to the
# same line separated by a semicolon instead of creating another active line.
#
# Example with another module path:
#   MAYA_MODULE_PATH=D:\path\to\bakedanuki\modules;D:\another\maya\modules

MAYA_MODULE_PATH=D:\path\to\bakedanuki\modules
